{
  "info": {
    "_postman_id": "c2a4f7ce-4fd3-4f9f-bec3-3f58fa728f81",
    "name": "Tiko API",
    "description": "Complete collection for all Tiko backend APIs. \n\n**Variables:**\n- `baseUrl` — switch between local (`http://localhost:5000`) and production (`https://tiko-server.vercel.app`)\n\n**Auth note:** Login sets an `auth_token` httpOnly cookie. In Postman, enable **\"Send cookies\"** and the cookie will be forwarded automatically on subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:5000",          "description": "Switch to https://tiko-server.vercel.app for production" },
    { "key": "verifyToken",  "value": "",  "description": "Paste token from verification email" },
    { "key": "resetToken",   "value": "",  "description": "Paste token from password reset email" },
    { "key": "productId",    "value": "",  "description": "Set by POST /api/products test script" },
    { "key": "productSlug",  "value": "clay-studio-teapot" },
    { "key": "categoryId",   "value": "",  "description": "Set manually after GET /api/categories" },
    { "key": "customerId",   "value": "",  "description": "Set manually after GET /api/customers" },
    { "key": "orderId",      "value": "",  "description": "Set by POST /api/orders test script" },
    { "key": "imageId",      "value": "",  "description": "Set manually from product images response" }
  ],
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Server health check. Returns 200 OK if the API is up."
          }
        }
      ]
    },

    {
      "name": "Auth",
      "description": "Authentication & account management. Login uses httpOnly cookies.",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Demo User\",\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"Admin@1234\",\n  \"confirmPassword\": \"Admin@1234\",\n  \"phone\": \"+201012345678\",\n  \"address\": \"Cairo, Egypt\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Initiates registration — sends a verification email. Account is inactive until the email link is clicked."
          }
        },
        {
          "name": "GET /api/auth/verify-email",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/verify-email?token={{verifyToken}}",
            "description": "Verifies email address. Paste the token from the verification email into the `verifyToken` variable."
          }
        },
        {
          "name": "POST /api/auth/login  ← sets auth_token cookie",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tiko.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in and sets an httpOnly `auth_token` cookie. All subsequent protected requests will use this cookie automatically (ensure 'Send cookies' is enabled in Postman)."
          }
        },
        {
          "name": "GET /api/auth/me  [auth required]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Returns the currently authenticated user's profile. Requires auth_token cookie."
          }
        },
        {
          "name": "PATCH /api/auth/profile  [auth required]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phone\": \"+201012345678\",\n  \"address\": \"Cairo, Egypt\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/profile",
            "description": "Updates the authenticated user's name, phone, or address."
          }
        },
        {
          "name": "POST /api/auth/change-password  [auth required]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Admin@1234\",\n  \"newPassword\": \"Admin@5678\",\n  \"confirmPassword\": \"Admin@5678\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/change-password",
            "description": "Changes the authenticated user's password. Requires knowing the current password."
          }
        },
        {
          "name": "PATCH /api/auth/avatar  [auth required, multipart]",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "description": "Avatar image file (JPG/PNG, max 5 MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/avatar",
            "description": "Uploads a new avatar image for the authenticated user. Returns { avatarUrl }."
          }
        },
        {
          "name": "POST /api/auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tiko.com\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Sends a password reset email. Always returns 200 to prevent email enumeration."
          }
        },
        {
          "name": "POST /api/auth/reset-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"Admin@1234\",\n  \"confirmPassword\": \"Admin@1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Resets password using the token from the reset email. Paste token into `resetToken` variable."
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Clears the auth_token cookie and logs out."
          }
        }
      ]
    },

    {
      "name": "Categories",
      "item": [
        {
          "name": "GET /api/categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories",
            "description": "Returns all active (non-deleted) categories sorted by sortOrder."
          }
        },
        {
          "name": "POST /api/categories  [admin]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stationery\",\n  \"sortOrder\": 10\n}"
            },
            "url": "{{baseUrl}}/api/categories",
            "description": "Creates a new category. Slug is auto-generated from name."
          }
        },
        {
          "name": "DELETE /api/categories/:id  [admin]",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/categories/{{categoryId}}",
            "description": "Soft-deletes the category and cascades soft-delete to all products in it."
          }
        }
      ]
    },

    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=12&category=&search=&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "12" },
                { "key": "category", "value": "",   "description": "Filter by category slug" },
                { "key": "search",   "value": "",   "description": "Search by name" },
                { "key": "status",   "value": "ACTIVE", "description": "ACTIVE | DRAFT | ARCHIVED" }
              ]
            },
            "description": "Paginated product listing. Public."
          }
        },
        {
          "name": "GET /api/products/new-arrivals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/new-arrivals",
            "description": "Returns the 4 most recently added ACTIVE products. Used on the landing page New Arrivals section."
          }
        },
        {
          "name": "GET /api/products/best-sellers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/best-sellers",
            "description": "Returns top 2 products ranked by total ordered quantity (excludes CANCELLED orders). Falls back to newest products when order history is sparse."
          }
        },
        {
          "name": "GET /api/products/slug/:slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/slug/{{productSlug}}",
            "description": "Fetches a single product by its URL slug. Public."
          }
        },
        {
          "name": "GET /api/products/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "Fetches a single product by UUID. Public."
          }
        },
        {
          "name": "GET /api/products/admin/:id  [admin]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/admin/{{productId}}",
            "description": "Admin version — returns product including DRAFT/ARCHIVED status."
          }
        },
        {
          "name": "POST /api/products  [admin]",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook Set\",\n  \"material\": \"Recycled Paper\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Minimal recycled notebook pack.\",\n  \"price\": 1850,\n  \"stockQty\": 20,\n  \"lowStockThreshold\": 5,\n  \"status\": \"ACTIVE\",\n  \"colors\": [\"Black\", \"White\"],\n  \"sizes\": [\"A5\", \"A4\"]\n}"
            },
            "url": "{{baseUrl}}/api/products",
            "description": "Creates a new product. Price is in minor units (piastres): 1850 = 18.50 EGP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id)   pm.collectionVariables.set('productId', json.id);",
                  "  if (json && json.slug) pm.collectionVariables.set('productSlug', json.slug);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/products/:id  [admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockQty\": 4,\n  \"lowStockThreshold\": 5,\n  \"price\": 1999,\n  \"colors\": [\"Black\", \"Red\"],\n  \"sizes\": [\"S\", \"M\", \"L\"]\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "Partially updates product fields. Send only fields you want to update."
          }
        },
        {
          "name": "POST /api/products/:id/images  [admin, multipart]",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "images", "type": "file", "description": "First image (JPG/PNG/WEBP)" },
                { "key": "images", "type": "file", "description": "Second image (optional)" }
              ]
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/images",
            "description": "Uploads product images (max 10). Uploaded to Cloudinary. Returns array of image objects."
          }
        },
        {
          "name": "DELETE /api/products/:id/images/:imageId  [admin]",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}",
            "description": "Deletes a specific product image from Cloudinary and the database."
          }
        },
        {
          "name": "DELETE /api/products/:id  [admin, soft delete]",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "Soft-deletes the product (sets deletedAt). Product is hidden from public but preserved in order history."
          }
        }
      ]
    },

    {
      "name": "Delivery Zones",
      "item": [
        {
          "name": "GET /api/delivery-zones",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/delivery-zones",
            "description": "Returns all active delivery zones with fees. Fee is returned in both EGP (fee) and minor units (feeMinor)."
          }
        }
      ]
    },

    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /api/orders  (guest or logged-in checkout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"selectedColor\": \"Black\",\n      \"selectedSize\": \"M\"\n    }\n  ],\n  \"shippingFullName\": \"Ahmed Hassan\",\n  \"shippingPhone\": \"01012345678\",\n  \"shippingStreet\": \"15 Tahrir Square, Cairo\",\n  \"deliveryZoneCode\": \"cairo\",\n  \"paymentMethod\": \"CASH\",\n  \"guestEmail\": \"ahmed@example.com\",\n  \"notes\": \"Call before delivery\"\n}"
            },
            "url": "{{baseUrl}}/api/orders",
            "description": "Places a new order. Works for both guests (no cookie) and logged-in users (auth_token cookie). `paymentMethod` must be CASH or INSTAPAY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  var json = pm.response.json();",
                  "  if (json && json.id) pm.collectionVariables.set('orderId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/orders/upload-transaction  (public, multipart)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "InstaPay transaction screenshot (JPG/PNG, max 10 MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/upload-transaction",
            "description": "Uploads a transaction screenshot BEFORE the order is placed. Returns { url } — pass this URL in the order body as `transactionImageUrl`."
          }
        },
        {
          "name": "POST /api/orders/:id/transaction-image  (public, multipart)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "InstaPay transaction screenshot (JPG/PNG, max 10 MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/transaction-image",
            "description": "Uploads the customer's InstaPay payment screenshot AFTER order placement. Public — no auth required so guest customers can submit their payment proof."
          }
        },
        {
          "name": "GET /api/orders  [admin]",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=1&limit=20&status=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" },
                { "key": "status", "value": "", "description": "Filter: PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED" },
                { "key": "search", "value": "", "description": "Search by order number or customer name" }
              ]
            },
            "description": "Paginated list of all orders. Admin only."
          }
        },
        {
          "name": "GET /api/orders/stats  [admin]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/stats",
            "description": "Returns dashboard stats: total orders, total revenue, pending count, etc."
          }
        },
        {
          "name": "GET /api/orders/:id  [admin]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": "Returns full order detail with items, payment, and status history."
          }
        },
        {
          "name": "PATCH /api/orders/:id/status  [admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\",\n  \"note\": \"Payment confirmed, preparing order\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/status",
            "description": "Updates order status. Valid values: PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED."
          }
        },
        {
          "name": "PATCH /api/orders/:id/payment  [admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\",\n  \"instapayReference\": \"INSTA-123456\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/payment",
            "description": "Updates the payment record for an order. Admin only."
          }
        }
      ]
    },

    {
      "name": "Customers  [admin]",
      "description": "All customer endpoints require admin authentication.",
      "item": [
        {
          "name": "GET /api/customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?page=1&limit=20&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" },
                { "key": "search", "value": "", "description": "Search by name or email" }
              ]
            },
            "description": "Paginated list of all customers."
          }
        },
        {
          "name": "GET /api/customers/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/{{customerId}}",
            "description": "Returns a customer's full profile including their order history."
          }
        },
        {
          "name": "PATCH /api/customers/:id/status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/status",
            "description": "Updates a customer's status. Valid values: ACTIVE | INACTIVE."
          }
        },
        {
          "name": "DELETE /api/customers/:id  (soft delete)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/customers/{{customerId}}",
            "description": "Soft-deletes a customer (sets deletedAt). Data is preserved for order history."
          }
        }
      ]
    },

    {
      "name": "Analytics  [admin]",
      "description": "Admin-only analytics endpoints. Require an authenticated admin session (auth_token cookie).",
      "item": [
        {
          "name": "GET /api/analytics/sales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/analytics/sales?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "sales"],
              "query": [
                { "key": "days", "value": "30", "description": "Number of days to look back. Omit for all-time." }
              ]
            },
            "description": "Returns daily aggregated revenue and order count for the sales chart."
          }
        },
        {
          "name": "GET /api/analytics/popular-products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/analytics/popular-products?days=30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "popular-products"],
              "query": [
                { "key": "days", "value": "30", "description": "Number of days to look back. Omit for all-time." }
              ]
            },
            "description": "Returns the top 10 products ranked by units sold."
          }
        }
      ]
    },

    {
      "name": "Contact Us",
      "item": [
        {
          "name": "POST /api/contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Hassan\",\n  \"email\": \"ahmed@example.com\",\n  \"message\": \"Hello, I have a question about my order.\"\n}"
            },
            "url": "{{baseUrl}}/api/contact",
            "description": "Sends a contact form email to the store owner. Public endpoint — no auth required."
          }
        }
      ]
    },

    {
      "name": "Payment Methods Settings",
      "description": "Admin endpoints for configuring which payment methods are available at checkout.",
      "item": [
        {
          "name": "GET /api/settings/payment-methods  (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/settings/payment-methods",
            "description": "Returns all ENABLED payment methods. Used by the checkout page to display options to customers."
          }
        },
        {
          "name": "GET /api/settings/payment-methods/admin  [admin]",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/settings/payment-methods/admin",
            "description": "Returns ALL payment methods (enabled and disabled) with full config. Admin only."
          }
        },
        {
          "name": "PATCH /api/settings/payment-methods/CASH  [admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isEnabled\": true,\n  \"config\": {}\n}"
            },
            "url": "{{baseUrl}}/api/settings/payment-methods/CASH",
            "description": "Toggles Cash on Delivery on/off."
          }
        },
        {
          "name": "PATCH /api/settings/payment-methods/INSTAPAY  [admin]",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isEnabled\": true,\n  \"config\": {\n    \"email\": \"mayar201500@instapay\",\n    \"phone\": \"01025350571\",\n    \"paymentLink\": \"https://ipn.eg/S/mayar201500/instapay/5CZr0y\",\n    \"qrCodeUrl\": \"https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=https%3A%2F%2Fipn.eg%2FS%2Fmayar201500%2Finstapay%2F5CZr0y\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/settings/payment-methods/INSTAPAY",
            "description": "Updates the Instapay configuration. At least one of email, phone, or paymentLink is required when isEnabled is true."
          }
        },
        {
          "name": "POST /api/settings/payment-methods/upload-qr  [admin, multipart]",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "Instapay QR code image (JPG/PNG, max 5 MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/settings/payment-methods/upload-qr",
            "description": "Uploads a custom QR code image to Cloudinary. Returns { qrCodeUrl }. Save this URL then call PATCH INSTAPAY to apply it."
          }
        }
      ]
    }

  ]
}
